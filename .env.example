# ================================================================
# Gulfam Sweets & Dairy - Supabase Backend Configuration
# ================================================================
# Browser-safe Supabase connection settings.
# Obtain these from your Supabase Dashboard: Project Settings -> API.
#
# If omitted or left blank, the app functions in safe Demo Mode
# with cryptographic SHA-256 password hashing and client persistence.
# ================================================================

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternatively:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ================================================================
# Automatic New Order Email Notifications (Vercel Serverless / Edge)
# ================================================================
# Get your free API key at https://resend.com (free 3,000 emails/mo)
# Add these in Vercel -> Project Settings -> Environment Variables:
RESEND_API_KEY=re_123456789
ADMIN_NOTIFICATION_EMAIL=hoomankhan701@gmail.com
# Optional: customize sender if you have a verified domain on Resend
# RESEND_FROM_EMAIL=Gulfam Sweets <orders@gulfamsweets.com>
