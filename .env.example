# ================================================================
# Gulfam Sweets & Dairy - Supabase Backend Configuration
# ================================================================
# Browser-safe Supabase connection settings.
# Obtain these from your Supabase Dashboard: Project Settings -> API.
#
# If omitted or left blank, the app functions in safe Demo Mode
# with cryptographic SHA-256 password hashing and client persistence.
# ================================================================

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternatively:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
